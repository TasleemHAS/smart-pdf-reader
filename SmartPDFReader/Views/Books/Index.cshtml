@model IEnumerable<SmartPDFReader.Models.Book>

@{
    ViewData["Title"] = "My Books";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Books</h1>
        <a href="@Url.Action("Upload", "Books")" class="btn btn-success">
            <i class="fas fa-plus"></i> Upload New Book
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <h4>No books yet</h4>
            <p>Upload your first PDF book to get started!</p>
            <a href="@Url.Action("Upload", "Books")" class="btn btn-primary">Upload Book</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var book in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@book.Title</h5>
                            <p class="card-text">
                                <strong>Author:</strong> @(book.Author ?? "Unknown")<br>
                                <strong>Uploaded:</strong> @book.UploadDate.ToString("MMM dd, yyyy")
                            </p>
                        </div>
                        <div class="card-footer">
                            <!-- FIXED: Use direct URL with correct parameter name -->
                            <a href="/Questions/Index/@book.Id" class="btn btn-primary btn-sm">
                                Ask Questions
                            </a>
                            <form method="post" action="@Url.Action("DeleteBook", "Books", new { id = book.Id })" 
                                  style="display: inline;" onsubmit="return confirm('Delete this book?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>