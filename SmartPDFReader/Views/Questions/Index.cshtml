@model IEnumerable<SmartPDFReader.Models.Question>
@{
    ViewData["Title"] = "Questions & Answers";
}

<div class="container mt-4">
    <!-- Status Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Questions & Answers</h1>
            <p class="text-muted mb-0">@ViewBag.BookTitle</p>
        </div>
        <div>
            <a href="/Questions/Ask/@ViewBag.BookId" class="btn btn-success me-2">
                <i class="fas fa-question-circle"></i> Ask New Question
            </a>
            <a href="/Books" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Back to Books
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="empty-state">
                <i class="fas fa-question-circle fa-3x text-muted mb-3"></i>
                <h3>No Questions Yet</h3>
                <p class="text-muted mb-4">Start by asking your first question about this book!</p>
                <a href="/Questions/Ask/@ViewBag.BookId" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus-circle"></i> Ask First Question
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var question in Model.OrderByDescending(q => q.AskedDate))
            {
                <div class="col-12 mb-4">
                    <div class="card question-card">
                        <div class="card-header d-flex justify-content-between align-items-center
                                            @(question.Answer.Contains("❌") || question.Answer.Contains("unable to extract") || question.Answer.Contains("error") ? "bg-warning" : "bg-success text-white")">
                            <div class="question-header">
                                <h5 class="card-title mb-1">@question.QuestionText</h5>
                                <small class="question-meta">
                                    <i class="fas fa-clock"></i> Asked: @question.AskedDate.ToString("MMM dd, yyyy 'at' h:mm tt")
                                </small>
                            </div>
                            <form method="post" action="/Questions/DeleteQuestion?id=@question.Id&bookId=@ViewBag.BookId"
                                  onsubmit="return confirm('Are you sure you want to delete this question?');" class="delete-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn @(question.Answer.Contains("❌") || question.Answer.Contains("unable to extract") ? "btn-outline-dark" : "btn-light") btn-sm">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                        <div class="card-body">
                            <!-- Show page number if it's meaningful -->
                            @if (question.PageNumber > 1)
                            {
                                <div class="mb-2">
                                    <span class="badge bg-info">
                                        <i class="fas fa-file-alt"></i> Page @question.PageNumber
                                    </span>
                                </div>
                            }

                            <div class="answer-content @(question.Answer.Contains("❌") || question.Answer.Contains("unable to extract") || question.Answer.Contains("error") ? "answer-warning" : "answer-success")">
                                <div class="answer-text" style="white-space: pre-wrap;">@question.Answer</div>
                            </div>

                            @if (question.Answer.Contains("unable to extract") || question.Answer.Contains("error while processing"))
                            {
                                <div class="alert alert-warning mt-3">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <strong>PDF Processing Issue:</strong> This PDF may contain scanned images or be in a format that cannot be processed.
                                    Please ensure your PDF contains selectable text for full functionality.
                                </div>
                            }

                            <div class="mt-3 text-end">
                                <small class="text-muted">
                                    <i class="fas fa-sync-alt"></i> Generated: @question.AskedDate.ToString("MMM dd, yyyy 'at' h:mm tt")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
<div class="mb-3">
    <a href="@Url.Action("ViewPdfContent", new { id = ViewBag.BookId })" class="btn btn-info btn-sm">
        <i class="fas fa-eye me-1"></i> View PDF Content
    </a>
</div>
<style>
    .question-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    i dont 
        .question-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
        border: none;
    }

    .question-header {
        flex: 1;
    }

    .question-meta {
        opacity: 0.9;
    }

    .answer-content {
        border-left: 4px solid;
        padding: 1.25rem;
        border-radius: 8px;
        margin: 1rem 0;
    }

    .answer-success {
        border-left-color: #28a745;
        background: linear-gradient(135deg, #f8fff9 0%, #f0f9f0 100%);
    }

    .answer-warning {
        border-left-color: #ffc107;
        background: linear-gradient(135deg, #fffef0 0%, #fff9e6 100%);
    }

    .answer-text {
        line-height: 1.6;
        font-size: 1rem;
    }

    .empty-state {
        padding: 3rem 1rem;
    }

        .empty-state i {
            opacity: 0.5;
        }

    .delete-form {
        margin-left: 1rem;
    }

    .btn-success {
        background: linear-gradient(135deg, #28a745, #20c997);
        border: none;
        font-weight: 600;
    }

        .btn-success:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
        }

    .bg-success {
        background: linear-gradient(135deg, #28a745, #20c997) !important;
    }

    .bg-warning {
        background: linear-gradient(135deg, #ffc107, #fd7e14) !important;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.5rem 0.75rem;
    }

    .alert {
        border: none;
        border-radius: 8px;
    }
</style>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            $('.alert').alert('close');
        }, 5000);

        // Smooth scroll to top when asking new question
        $('a[href*="Ask"]').on('click', function() {
            $('html, body').animate({ scrollTop: 0 }, 300);
        });
    </script>
}