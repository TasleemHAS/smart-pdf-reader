@{
    ViewData["Title"] = "PDF Content";
    var bookTitle = ViewBag.BookTitle;
    var pdfContent = ViewBag.PdfContent as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>PDF Content: @bookTitle</h2>
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Questions
        </a>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-file-pdf me-2"></i>Extracted Text Content
            </h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(pdfContent))
            {
                <div class="pdf-content" style="max-height: 600px; overflow-y: auto; white-space: pre-wrap; font-family: monospace; font-size: 0.9em;">
                    @pdfContent
                </div>
                <div class="mt-3 text-muted">
                    <small>
                        <i class="fas fa-info-circle me-1"></i>
                        This is the raw text extracted from your PDF. The Q&A system searches this content to answer your questions.
                    </small>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No content could be extracted from the PDF. The file may be scanned, encrypted, or contain only images.
                </div>
            }
        </div>
    </div>
</div>